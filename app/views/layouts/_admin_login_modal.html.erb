<div class="modal fade" id="adminLoginModal" tabindex="-1" aria-labelledby="adminLoginLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="adminLoginLabel">Admin-Anmeldung</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <%= form_with url: login_path, method: :post, local: true do %>
          <div class="mb-3">
            <%= label_tag :user, "Benutzer" %>
            <%= text_field_tag :user, nil, class: "form-control", autofocus: true %>
          </div>

          <div class="mb-3">
            <%= label_tag :password, "Passwort" %>
            <%= password_field_tag :password, nil, class: "form-control" %>
          </div>

          <div class="d-grid">
            <%= submit_tag "Anmelden", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
