<!DOCTYPE html>
<html>
  <head>
    <title>Tallysheet</title>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track" => true %>
    <%= csrf_meta_tags %>
    <%= javascript_importmap_tags %>
  </head>
  <body role="document">
  	<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top" role="navigation">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="<%= root_url %>">
        <img src="/images/logo_small.png" height="40" class="me-2" />
        Tallysheet
        </a>
        <button class="navbar-toggler" type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item bg-warning"><%= active_link_to 'New entry', new_tallysheet_entry_path, class: "nav-link" %></li>
            <li class="nav-item"><%= active_link_to "Many new entries", { controller: "tallysheet_entries", action: "new_many" }, class: "nav-link" %></li>
            <li class="nav-item"><%= active_link_to "Latest entries", { controller: "tallysheet_entries", action: "latest" }, class: "nav-link" %></li>
            <li class="nav-item"><%= active_link_to 'Prices', { controller: "beverages", action: "prices" }, class: "nav-link" %></li>
          </ul>
          <ul class="navbar-nav ms-auto">
            <% if !authenticated? %>
              <li class="nav-item">
                <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#adminLoginModal">Login</a>
              </li>
            <% else %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown"
                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  Admin
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                  <li><%= active_link_to 'New consumer', new_consumer_path, class: "dropdown-item" %></li>
                  <li><%= active_link_to "All consumers", { controller: "consumers", action: "index" }, class: "dropdown-item" %></li>
                  <li><%= active_link_to 'Mail to all consumers', { controller: "dashboard", action: "mail" }, class: "dropdown-item" %></li>
                  <li><%= active_link_to "All beverages", { controller: "beverages", action: "index" }, class: "dropdown-item" %></li>
                  <li><%= active_link_to "All tallysheet entries", { controller: "tallysheet_entries", action: "index" }, class: "dropdown-item" %></li>
                  <li><%= active_link_to "All static flash messages", { controller: "static_flashes", action: "index" }, class: "dropdown-item" %></li>
                  <li><%= active_link_to "Update derived attributes", { controller: "consumers", action: "update_derived" }, class: "dropdown-item" %></li>
                  <li><%= link_to "Logout", logout_path, data: { turbo_method: :delete}, class: "dropdown-item" %></li>
                </ul>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>


<div aria-live="polite" aria-atomic="true" class="position-relative">
  <div class="toast-container position-fixed top-0 end-0 p-3" data-controller="static-flash">
	  <% if not @static_flashes.empty? and current_page?(root_url) %>
		  <% @static_flashes.each do |flash| %>
        <div data-static-flash-target="toast" data-sticky="true" role="alert" aria-live="assertive" aria-atomic="true" class="toast text-bg-<%= flash_class("success") %>">
			    <div class="toast-header"> 
            <small><button type="button" class="btn-close me-2" data-bs-dismiss="toast" aria-label="close"></button>
            Expires <%= flash.expires.to_formatted_s(:short) %></small>
          </div>
          <div class="toast-body">
			      <%= sanitize flash.content %>
          </div>
		    </div>
		  <% end %>
	  <% end %>
    <% if not flash.empty? %>
      <% flash.each do |key, value| %>
      <div data-static-flash-target="toast" role="alert" aria-live="assertive" aria-atomic="true" class="toast text-bg-<%= flash_class(key) %>">
        <div class="toast-body">
          <button type="button" class="btn-close me-2" data-bs-dismiss="toast" aria-label="close"></button>
        
          <%= value.html_safe %>
        </div>
      </div>
      <% end %>
    <% end %>
  </div>
</div>
<div id="navbar-spacer" style="padding-top: 7rem"></div>
    <% if content_for? :jumbotron %>
	<div class="jumbotron">
		<%= yield :jumbotron %>
	</div>
	<% else %>
	<div class="container">&nbsp;</div>
	<% end %>
    
    
  <div class="container" role="main" style="padding-top: 5em">
		<%= yield %>
  </div>
    
  <div class="container footer">
    <hr/>
    <center>
      <p class="text-body-secondyary small">
	    <a href="http://www.rubyonrails.org" target="_blank">Ruby On Rails</a> | 
	    <a href="http://www.getbootstrap.com" target="_blank">Bootstrap</a> | 
	    <a href="http://fortawesome.github.io/Font-Awesome/" target="_blank">Font Awesome</a> | 
	    <span><%= rendering_time %></span>
    </center>
  </div>
  
  <%= render "layouts/admin_login_modal" %>


  </body>
</html>
