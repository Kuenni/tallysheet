<%= form_for(@beverage, html: {class: "form-horizontal"}) do |f| %>
<% if @beverage.errors.any? %>
<div id="error_explanation">
	<h2><%= pluralize(@beverage.errors.count, "error") %> prohibited this beverage from being saved:</h2>

	<ul>
		<% @beverage.errors.full_messages.each do |msg| %>
		<li>
			<%= msg %>
		</li>
		<% end %>
	</ul>
</div>
<% end %>

<div class="input-group">
	<%= f.label :name, class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.text_field :name, class: "form-control", required: "required" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :price, class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<div class="input-group">
			<%= f.number_field :price_humanized, class: "form-control", required: "required", min: "0", max: "10000", step: "0.01" %>
			<span class="input-group-text">&euro;</span>
		</div>
	</div>
</div>

<div class="input-group">
	<%= f.label :available, class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<div class="form-control">
			<%= f.check_box :available, class: "form-check-input" %>
		</div>
	</div>
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= f.submit class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>
