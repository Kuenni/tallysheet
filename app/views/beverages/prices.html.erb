<div class="page-header"><h1>Preise</h1></div>

<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th><%= sortable "name", "Name" %></th>
      <th style="text-align:center"><%= sortable_amount "available", "Verfügbar" %></th>
      <th><%= sortable_numeric "price", "Preis" %></th>
    </tr>
  </thead>

  <tbody>
    <% @beverages.each do |beverage| %>
      <tr>
        <td>
	  <%= beverage.name %> 
	  <% unless @quota[beverage].nil? %>
	  <span class="badge text-bg-secondary"><%= (@quota[beverage] * 100).round %> %</span>
	  <% else %>
	  <span class="badge text-bg-secondary">0 %</span>
	  <% end %>
	</td>
        <td style="text-align:center"><i class="bi bi-<%= beverage.available ? 'check-circle' : 'x-square' %>" aria-hidden="true"></i></td>
        <td><%= beverage.price_humanized %> &euro;</td>
      </tr>
    <% end %>
  </tbody>
</table>

<hr>

<%= link_to 'Zurück', root_path, class: "btn btn-secondary btn-sm" %>
