<div class="page-header"><h1>Getränke auflisten</h1></div>

<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Name</th>
      <th>Preis</th>
      <th>Verfügbar</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @beverages.each do |beverage| %>
      <tr>
        <td><%= beverage.name %></td>
        <td><%= "%.2f" % beverage.price %> &euro;</td>
        <td><i class="bi bi-<%= beverage.available ? 'check-circle' : 'x-square' %>" aria-hidden="true"></i></td>
        <td><%= link_to 'Anzeigen', beverage, class: "btn btn-secondary btn-sm" %>
        <%= link_to 'Bearbeiten', edit_beverage_path(beverage), class: "btn btn-primary btn-sm" %>
        <%= link_to 'Löschen', beverage, data: { turbo_method: :delete, turbo_confirm: "Sind Sie sicher?" }, class: "btn btn-danger btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<hr>

<%= link_to 'Zurück', root_path, class: "btn btn-secondary btn-sm" %>
<%= link_to 'Neues Getränk', new_beverage_path, class: "btn btn-primary btn-sm" %>
