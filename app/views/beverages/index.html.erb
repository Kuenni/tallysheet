<div class="page-header"><h1>Listing beverages</h1></div>

<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Available</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @beverages.each do |beverage| %>
      <tr>
        <td><%= beverage.name %></td>
        <td><%= "%.2f" % beverage.price %> &euro;</td>
        <td><i class="bi bi-<%= beverage.available ? 'check-circle' : 'x-square' %>" aria-hidden="true"></i></td>
        <td><%= link_to 'Show', beverage, class: "btn btn-secondary btn-sm" %>
        <%= link_to 'Edit', edit_beverage_path(beverage), class: "btn btn-primary btn-sm" %>
        <%= link_to 'Destroy', beverage, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<hr>

<%= link_to 'Back', root_path, class: "btn btn-secondary btn-sm" %>
<%= link_to 'New Beverage', new_beverage_path, class: "btn btn-primary btn-sm" %>
