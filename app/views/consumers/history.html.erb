<div class="page-header">
	<h1><%= @consumer.name %> <small> Verlauf</small></h1>
</div>

<p class="text-muted"><%= page_entries_info @tallysheet_entries %></p>

<table class="table table-striped table-hover">
	<thead>
		<th>Datum</th>
		<th>Strich</th>
		<th>Anzahl</th>
		<th>Preis</th>
	</thead>
	<% @tallysheet_entries.each do |e| %>
	<tr>
		<td><%= e.created_at.to_formatted_s(:long) %></td>
		<td><%= e.beverage.name %></td>
		<td><%= e.amount %></td>
		<td><%= "%.2f" % e.price %> &euro;</td>
	</tr>
	<% end %>
</table>

<%= will_paginate @tallysheet_entries, :renderer => BootstrapPagination::Rails %>

<hr>

<%= link_to 'Zurück', consumer_path(@consumer), class: "btn btn-secondary btn-sm" %>