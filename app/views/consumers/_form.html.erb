<%= form_for(@consumer, html: {class: "form-horizontal"}) do |f| %>
<% if @consumer.errors.any? %>
<div id="error_explanation">
	<h2><%= @consumer.errors.count %> <%= @consumer.errors.count == 1 ? "Fehler" : "Fehler" %> verhinderten das Speichern dieses Namens:</h2>
	<ul>
		<% @consumer.errors.full_messages.each do |msg| %>
		<li>
			<%= msg %>
		</li>
		<% end %>
	</ul>
</div>
<% end %>

<div class="input-group">
	<%= f.label :name, "Name", class: "input-group-text col-sm-1" %>
	<div class="col-sm-5">
		<%= f.text_field :name, class: "form-control", required: "required" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :email, "E-Mail", class: "input-group-text col-sm-1" %>
	<div class="col-sm-5">
		<%= f.email_field :email, class: "form-control", required: "required" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :visible, "Sichtbar", class: "input-group-text col-sm-1" %>
	<div class="col-sm-5">
		<div class="form-control">
			<%= f.check_box :visible, class: "form-check-input" %>
		</div>
	</div>
</div>

<div class="input-group">
	<%= f.label :credit, "Guthaben", class: "input-group-text col-sm-1" %>
	<div class="col-sm-5">
		<div class="input-group">
		<%= f.number_field :credit_humanized, class: "form-control", required: "required", min: "-10000", max: "10000", step: "0.01" %>
		<span class="input-group-text">&euro;</span>
		</div>
	</div>	
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= f.submit "Speichern", class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>
