<div class="page-header">
	<h1><%= @consumer.name %> <small>Guthaben übertragen</small></h1>
</div>

<%= form_tag(consumer_transfer_path(@consumer), class: "form-horizontal") do %>

<div class="form-group">
	<%= label_tag :recipient, "Empfänger", class: "col-sm-2 form-label" %>
	<div class="col-sm-10">
		<%= select_tag :recipient_id, options_for_select(@recipients.collect{ |r| [r.name, r.id] }), selected: nil, include_blank: true, class: "form-control", required: "required" %>
	</div>
</div>

<div class="form-group">
	<%= label_tag :amount, "Betrag", class: "col-sm-2 form-label" %>
	<div class="col-sm-10">
		<div class="input-group">
			<%= number_field_tag :amount, "", placeholder: "0.00", class: "form-control", required: "required", min: "-10000", max: "10000", step: "0.01" %>
			<span class="input-group-addon">&euro;</span>
		</div>
		(aktuelle Schulden: <%= style_debt @consumer.debt %>)
	</div>
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= submit_tag 'Übertragen', data: { confirm: 'Sind Sie sicher?' }, class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>

<hr>

<%= link_to 'Zurück', consumer_path(@consumer), class: "btn btn-secondary btn-sm" %>