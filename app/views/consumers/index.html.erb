<div class="page-header"><h1>Nutzer auflisten</h1></div>

<table class="table table-striped table-hover">
	<thead>
		<tr>
			<th>Name</th>
			<th>E-Mail</th>
			<th>Sichtbar</th>
			<th>Guthaben</th>
			<th></th>
		</tr>
	</thead>

	<tbody>
		<% @consumers.each do |consumer| %>
		<tr>
			<td><%= consumer.name %></td>
			<td><% if authenticated? %><%= consumer.email %><% else %>-<% end %></td>
        	<td><i class="bi bi-<%= consumer.visible ? 'check-circle' : 'x-square' %>" aria-hidden="true"></i></td>
			<td><%= style_credit consumer.credit %></td>
			<td><%= link_to 'Anzeigen', consumer, class: "btn btn-secondary btn-sm" %>
			<%= link_to 'Bezahlen', consumer_pay_path(consumer), class: "btn btn-success btn-sm" %>
			<%= link_to 'Bearbeiten', edit_consumer_path(consumer), class: "btn btn-primary btn-sm" %>
			<%= link_to 'Löschen', consumer, data: { turbo_method: :delete, turbo_confirm: "Sind Sie sicher?" }, class: "btn btn-danger btn-sm", disabled: !consumer.destroyable? %></td>
		</tr>
		<% end %>
	</tbody>
</table>

<hr>

<%= link_to 'Zurück', root_path, class: "btn btn-secondary btn-sm" %>
<%= link_to 'E-Mail an alle Nutzer', {controller: "dashboard", action: "mail"}, class: "btn btn-secondary btn-sm" %>
<%= link_to 'Neuer Nutzer', new_consumer_path, class: "btn btn-primary btn-sm" %>
