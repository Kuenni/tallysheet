<div class="page-header">
	<h1><%= @consumer.name %> <small>Schulden bezahlen</small></h1>
</div>

<p>
	Ihr Kontostand ergibt sich aus der Summe Ihrer konsumierten Getränke abzüglich Ihres Guthabens. Überzahlungen werden als Guthaben gutgeschrieben.
</p>

<%= form_tag(consumer_pay_path(@consumer), class: "form-horizontal") do %>

<div class="input-group">
	<%= label_tag :amount, "Betrag", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<div class="input-group">
			<%= number_field_tag :amount, "", placeholder: "0.00", class: "form-control", required: "required", min: "-10000", max: "10000", step: "0.01" %>
			<span class="input-group-text">&euro;</span>
		</div>		
	</div>
</div>
<div class="col-sm-5 offset-sm-1">
(aktuelle Schulden: <%= style_debt @consumer.debt %>)
</div>
<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= submit_tag 'Bezahlen', class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>

<hr>

<%= link_to 'Zurück', consumer_path(@consumer), class: "btn btn-secondary btn-sm" %>