<div class="page-header">
	<h1><%= @consumer.name %> <small>E-Mail</small></h1>
</div>

<p>
	Senden Sie eine E-Mail an diesen Kameraden.
	Nur Text verwenden, kein HTML.
</p>

<%= form_tag(consumer_mail_path(@consumer), class: "form-horizontal") do %>

<div class="form-group">
	<%= label_tag :subject, "Betreff", class: "col-sm-2 form-label" %>
	<div class="col-sm-10">
		<%= text_field_tag :subject, "", placeholder: "Betreff", class: "form-control", required: "required" %>
	</div>
</div>

<div class="form-group">
	<%= label_tag :reply_to, "Antwort an", class: "col-sm-2 form-label" %>
	<div class="col-sm-10">
		<%= email_field_tag :reply_to, "", placeholder: "Antwortadresse", class: "form-control", required: "required" %>
	</div>
</div>

<div class="form-group">
	<div class="col-sm-10 offset-sm-1 text-muted">
		Hallo <%= @consumer.name%>,<br/>
		</br/>
	</div>
</div>
	
<div class="form-group">
	<%= label_tag :body, "Text", class: "col-sm-2 form-label" %>
	<div class="col-sm-10">
		<%= text_area_tag :body, nil, placeholder: "Ihre Nachricht hier...", class: "form-control", required: "required" %>
	</div>
</div>

<div class="form-group">
	<div class="col-sm-10 offset-sm-1 text-muted">
		--<br/>
		Die Strichliste ist verfügbar unter <%= root_url %>
	</div>
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= submit_tag 'Senden', class: "btn btn-primary btn-sm", data: { confirm: 'Sind Sie sicher?' } %>
	</div>
</div>

<% end %>

<hr>

<%= link_to 'Zurück', consumer_path(@consumer), class: "btn btn-secondary btn-sm" %>