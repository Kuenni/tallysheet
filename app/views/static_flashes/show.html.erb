<div class="page-header"><h1>System-Meldung</h1></div>

<form class="form-horizontal" role="form">
	<div class="form-group">
		<label class="col-sm-2 form-label">Gültig bis</label>
		<div class="col-sm-10">
  			<input value="<%= @static_flash.expires.to_formatted_s(:db) %>" name="expires" type="text" class="form-control" disabled/>
  		</div>
	</div>
	<div class="form-group">
		<label class="col-sm-2 form-label">Inhalt</label>
		<div class="col-sm-10">
			<textarea name="expires" class="form-control" disabled><%= sanitize @static_flash.content %></textarea>	
		</div>
	</div>
	<div class="form-group">
		<div class="offset-sm-1 col-sm-10">
			<%= link_to 'Bearbeiten', edit_static_flash_path(@static_flash), class: "btn btn-primary btn-sm" %>
		</div>
	</div>
</form>

<hr>

<%= link_to 'Zurück', static_flashes_path, class: "btn btn-secondary btn-sm" %>
