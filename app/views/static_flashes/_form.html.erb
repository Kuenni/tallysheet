<%= form_for(@static_flash, html: {class: "form-horizontal"}) do |f| %>
  <% if @static_flash.errors.any? %>
    <div id="error_explanation">
      <h2><%= @static_flash.errors.count %> Fehler verhinderten das Speichern dieser System-Meldung:</h2>

      <ul>
      <% @static_flash.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

<div class="input-group">
	<%= f.label :expires, "Gültig bis", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5 input-group-text">
		<%= f.datetime_select :expires, class: "form-control" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :content, "Inhalt", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.text_area :content, class: "form-control", required: "required" %>
	</div>
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= f.submit "Speichern", class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>
