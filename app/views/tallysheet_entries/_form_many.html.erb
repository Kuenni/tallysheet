<p>
	Die Strichliste jedes Kameraden wird um eins erhöht. Es werden nur sichtbare Namen angezeigt.
</p>

<%= form_for(:tallysheet_entries, url: tallysheet_entries_create_many_path, html: {class: "form-horizontal"}) do |f| %>

<div class="input-group">
		<%= f.label :beverage, "Getränk", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.collection_select :beverage_id, @beverages, :id, :name, {include_blank: true}, class: "form-select", required: "required" %>
	</div>
</div>
<hr>
<div class="form-group">
	<strong>
		<%= f.label :consumer, "Name", class: "col-sm-2 form-label" %>
	</strong>
	<div class="col-sm-10">
		<%= f.collection_check_boxes :consumer_ids, @consumers, :id, :name, class: "form-control" do |b| %>
			<div class="form-check form-check-inline">
    			<%= b.check_box(class: "form-check-input") %>
    			<%= b.label(class: "form-check-label") %>
  			</div>
		<% end %>
	</div>
</div>
<hr>
<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= f.submit "Speichern", class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>
