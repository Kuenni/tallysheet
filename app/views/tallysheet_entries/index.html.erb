<div class="page-header"><h1>Strichlisteneinträge auflisten</h1></div>

<p class="text-muted"><%= page_entries_info @tallysheet_entries %></p>

<table class="table table-striped table-hover">
	<thead>
		<tr>
			<th>Datum</th>
			<th>Name</th>
			<th>Getränk</th>
			<th>Anzahl</th>
			<th>Preis</th>
			<th>Bezahlt</th>
			<th></th>
			<th></th>
			<th></th>
		</tr>
	</thead>

	<tbody>
		<% @tallysheet_entries.each do |tallysheet_entry| %>
		<tr>
			<td><%= tallysheet_entry.created_at.to_formatted_s(:long) %></td>
			<td><%= tallysheet_entry.consumer != nil ? tallysheet_entry.consumer.name : '-' %></td>
			<td><%= tallysheet_entry.beverage != nil ? tallysheet_entry.beverage.name : '-' %></td>
			<td><%= tallysheet_entry.amount %></td>
			<td><%= "%.2f" % tallysheet_entry.price %> &euro;</td>
			<td><i class="bi bi-<%= tallysheet_entry.payed ? 'check-circle' : 'x-square' %>" aria-hidden="true"></i></td>
			<td><%= link_to 'Anzeigen', tallysheet_entry, class: "btn btn-secondary btn-sm" %></td>
			<td><%= link_to 'Bearbeiten', edit_tallysheet_entry_path(tallysheet_entry), class: "btn btn-primary btn-sm" %></td>
			<td><%= link_to 'Löschen', tallysheet_entry, data: { turbo_method: :delete, turbo_confirm: "Sind Sie sicher?" }, class: "btn btn-danger btn-sm" %></td>
		</tr>
		<% end %>
	</tbody>
</table>

<%= will_paginate @tallysheet_entries, :renderer => BootstrapPagination::Rails %>

<hr>

<%= link_to 'Neuer Strichl', new_tallysheet_entry_path, class: "btn btn-success" %>
