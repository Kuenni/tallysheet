<%= form_for(@tallysheet_entry, html: {class: "form-horizontal"}) do |f| %>
<% if @tallysheet_entry.errors.any? %>
<div id="error_explanation">
	<h2><%= @tallysheet_entry.errors.count %> Fehler verhinderten das Speichern dieses Strichlisteneintrags:</h2>

	<ul>
		<% @tallysheet_entry.errors.full_messages.each do |msg| %>
		<li>
			<%= msg %>
		</li>
		<% end %>
	</ul>
</div>
<% end %>

<div class="input-group">
	<%= f.label :consumer, "Name", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.collection_select :consumer_id, @consumers, :id, :name, {include_blank: true}, class: "form-select", required: "required" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :beverage, "Getränk", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.collection_select :beverage_id, @beverages, :id, :name, {include_blank: true}, class: "form-select", required: "required" %>
	</div>
</div>

<div class="input-group">
	<%= f.label :amount, "Anzahl", class: "col-sm-1 input-group-text" %>
	<div class="col-sm-5">
		<%= f.number_field :amount, class: "form-control", required: "required", min: "1", max: "10000", step: "1" %>
	</div>
</div>

<div class="form-group">
	<div class="offset-sm-1 col-sm-10">
		<%= f.submit "Speichern", class: "btn btn-primary btn-sm" %>
	</div>
</div>

<% end %>
