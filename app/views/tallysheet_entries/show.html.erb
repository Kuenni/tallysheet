<div class="page-header"><h1>Strichlisteneintrag</h1></div>

<form class="form-horizontal" role="form">

	<div class="form-group">
		<label class="col-sm-2 form-label">Erstellt am</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.created_at.to_s() %>" type="text" class="form-control" disabled/>
		</div>
	</div>

	<div class="form-group">
		<label class="col-sm-2 form-label">Aktualisiert am</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.updated_at.to_s() %>" type="text" class="form-control" disabled/>
		</div>
	</div>
	
	<div class="form-group">
		<label class="col-sm-2 form-label">Name</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.consumer.name %>" type="text" class="form-control" disabled/>
		</div>
	</div>

	<div class="form-group">
		<label class="col-sm-2 form-label">Getränk</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.beverage.name %>" type="text" class="form-control" disabled/>
		</div>
	</div>

	<div class="form-group">
		<label class="col-sm-2 form-label">Anzahl</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.amount %>" type="text" class="form-control" disabled/>
		</div>
	</div>

	<div class="form-group">
		<label class="col-sm-2 form-label">Preis</label>
		<div class="col-sm-10">
			<div class="input-group">
				<input value="<%= "%.2f" % @tallysheet_entry.price %>" name="saldo" type="text" class="form-control" disabled/>
				<span class="input-group-addon">&euro;</span>
			</div>
		</div>
	</div>

	<div class="form-group">
		<label class="col-sm-2 form-label">Bezahlt</label>
		<div class="col-sm-10">
			<input value="<%= @tallysheet_entry.payed %>" type="text" class="form-control" disabled/>
		</div>
	</div>

	<div class="form-group">
		<div class="offset-sm-1 col-sm-10">
			<%= link_to 'Bearbeiten', edit_tallysheet_entry_path(@tallysheet_entry), class: "btn btn-primary btn-sm" %>
		</div>
	</div>

</form>

<hr>

<%= link_to 'Zurück', tallysheet_entries_path, class: "btn btn-secondary btn-sm" %>
